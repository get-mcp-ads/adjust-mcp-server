    {
      "name": "adjust_run_report",
      "title": "adjust run report",
      "description": "Read an attribution/performance report for one allowlisted Adjust app. Preserves native totals, warnings, attribution options, currency and UTC offset. Missing metrics are null; ratios are native fractions. A truncated or partial result is not a complete extraction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "appToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "description": "Exact Adjust application token from ADJUST_APP_TOKENS. Applications are separate from advertising accounts."
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "First date of the reporting period, in YYYY-MM-DD format."
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last date of the reporting period, in YYYY-MM-DD format, on or after startDate."
          },
          "dimensions": {
            "description": "Native reporting dimensions. Validate compatibility with the selected metrics.",
            "default": [
              "os_name",
              "day",
              "network",
              "campaign_id_network",
              "campaign_network"
            ],
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week",
                "month",
                "year",
                "quarter",
                "app",
                "app_token",
                "network",
                "partner",
                "partner_name",
                "partner_id",
                "channel",
                "platform",
                "os_name",
                "device_type",
                "country",
                "country_code",
                "region",
                "ad_account_id",
                "store_id",
                "store_type",
                "currency",
                "currency_code",
                "campaign",
                "campaign_network",
                "campaign_id_network",
                "adgroup",
                "adgroup_network",
                "adgroup_id_network",
                "creative",
                "creative_network",
                "creative_id_network",
                "source_network",
                "source_id_network"
              ]
            }
          },
          "metrics": {
            "description": "Native or documented calculated metric names to request. Check compatibility with the selected dimensions.",
            "default": [
              "installs",
              "clicks",
              "impressions"
            ],
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[A-Za-z][A-Za-z0-9_ ]*$"
            }
          },
          "currency": {
            "description": "Explicit ISO currency for money metrics. Keep the same currency across comparisons.",
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "utcOffset": {
            "description": "Fixed UTC offset; +00:00 by default. Split local-date comparisons if the offset changes during the period.",
            "default": "+00:00",
            "type": "string"
          },
          "attributionSource": {
            "description": "Assign activity to the first install source or the native dynamic reattribution source.",
            "default": "dynamic",
            "type": "string",
            "enum": [
              "first",
              "dynamic"
            ]
          },
          "attributionTypes": {
            "description": "Optional engagement filter. Omit for an unfiltered report including native organic data. Empty types in output means no engagement filter.",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "click",
                "impression",
                "engaged_ad"
              ]
            }
          },
          "reattributed": {
            "description": "Include all users, reattributed users only, or users without reattribution.",
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "true",
              "false"
            ]
          },
          "adSpendMode": {
            "description": "Native source of ad spend. Keep the same mode across comparisons and avoid counting overlapping spend twice.",
            "default": "network",
            "type": "string",
            "enum": [
              "adjust",
              "network",
              "mixed"
            ]
          },
          "cohortMaturity": {
            "description": "Include current cohort values or use mature-only mode, which may zero immature cohorts.",
            "default": "immature",
            "type": "string",
            "enum": [
              "mature",
              "immature"
            ]
          },
          "osNames": {
            "description": "Operating system filter, for example ios or android. Keep os_name in dimensions to compare platforms.",
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android",
                "bada",
                "blackberry",
                "ios",
                "linux",
                "macos",
                "server",
                "symbian",
                "unknown",
                "webos",
                "windows",
                "windows-phone"
              ]
            }
          },
          "iapRevenueMode": {
            "description": "In-app revenue percentage. Retain the same setting across comparisons.",
            "default": "GROSS_100",
            "type": "string",
            "enum": [
              "GROSS_100",
              "GROSS_85",
              "GROSS_70",
              "GROSS_60"
            ]
          },
          "filters": {
            "description": "Filters combined according to this tool's query schema. Use provider field names and the declared operators.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 120,
                  "pattern": "^[A-Za-z][A-Za-z0-9_ ]*$",
                  "description": "A documented dimension, or a metric requested in this report. app_token cannot be filtered."
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "in",
                    "not_in",
                    "contains",
                    "exclude",
                    "lt",
                    "lte",
                    "gt",
                    "gte",
                    "eq",
                    "ne"
                  ],
                  "description": "Dimensions accept in, not_in, contains, exclude, eq and ne. Metrics accept eq, ne, lt, lte, gt and gte."
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "number"
                    },
                    {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  ],
                  "description": "One value, or a list for in and not_in. Values must not contain commas."
                }
              },
              "required": [
                "field",
                "operator",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "limit": {
            "description": "Display row limit only; truncation is explicit and native totals are preserved.",
            "default": 1000,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "appToken",
          "startDate",
          "endDate"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Original tool result: parsed JSON when the text is JSON, otherwise the text or multiple MCP content blocks. Provider fields depend on the selected query."
          }
        },
        "required": [
          "result"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
