# adjust-mcp-server configuration. See the README.

# Required. The API token shown in your Adjust account settings.
# It is a bearer credential: keep it out of version control.
ADJUST_API_TOKEN=

# Required. Comma-separated Adjust app tokens this server may read.
# Every request is checked against this list before it is sent, and
# application discovery returns only these apps.
ADJUST_APP_TOKENS=

# Optional. production (default) or sandbox. Fixed for every report.
ADJUST_ENVIRONMENT=production

# There is no write setting. This server is read-only by design.
